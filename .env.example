# ============================================================================
# Contoh environment variables untuk deploy di Coolify / VPS (Supabase self-hosted)
# Salin file ini menjadi .env lalu isi nilai-nilai sesuai Supabase Anda.
# ============================================================================

# ----------------------------------------------------------------------------
# Mode aplikasi
# ----------------------------------------------------------------------------
# Supabase self-hosted tetap memakai layanan Auth Supabase. Set true hanya
# untuk instalasi PostgreSQL legacy tanpa SB_URL.
SELF_HOST=false
NODE_ENV=production

# ----------------------------------------------------------------------------
# JWT secret hanya dibutuhkan oleh mode PostgreSQL legacy (SELF_HOST=true).
# Generate dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ----------------------------------------------------------------------------
# JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# ----------------------------------------------------------------------------
# Izinkan pendaftaran publik? Untuk produksi sebaiknya false.
# Akun admin pertama sudah dibuat via SQL seed.
# ----------------------------------------------------------------------------
ALLOW_SIGNUP=false

# ----------------------------------------------------------------------------
# Konfigurasi Supabase self-hosted Anda (URL + kunci)
# ----------------------------------------------------------------------------
# URL Supabase (tanpa trailing slash). Contoh: https://supabase-anda.com
SB_URL=https://supabase-anda.com

# Publishable key Supabase (bisa ditemukan di Project Settings > API)
SB_PUBLISHABLE_KEY=GANTI_DENGAN_PUBLISHABLE_KEY_ANDA

# Service role key Supabase (RAHASIA — jangan dibagikan)
SB_SERVICE_ROLE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY_ANDA

# ----------------------------------------------------------------------------
# Variabel lama/alias (fallback, biarkan saja untuk kompatibilitas)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://supabase-anda.com
SUPABASE_PUBLISHABLE_KEY=GANTI_DENGAN_PUBLISHABLE_KEY_ANDA
SUPABASE_SERVICE_ROLE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY_ANDA

# ----------------------------------------------------------------------------
# Untuk browser bundle. "self" artinya aplikasi mengambil domain saat ini.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=self
VITE_SUPABASE_PUBLISHABLE_KEY=self-hosted
VITE_SUPABASE_PROJECT_ID=selfhost
