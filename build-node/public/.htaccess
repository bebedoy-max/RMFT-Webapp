# =============================================================================
# .htaccess untuk cPanel (Apache + Passenger / Node.js Selector)
#
# Letakkan file ini di document root domain (biasanya public_html/ atau
# public_html/nama-domain/). Saat memakai "Setup Node.js App", cPanel sudah
# membuat .htaccess Passenger otomatis — cukup TAMBAHKAN blok HTTPS + header
# di bawah, JANGAN hapus baris PassengerAppRoot yang dibuat cPanel.
# =============================================================================

# --- Paksa HTTPS -------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Header keamanan ---------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Aset ber-hash dari Vite boleh di-cache lama.
  <FilesMatch "\.(js|mjs|css|woff2|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Kompresi ----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# --- Blokir akses ke file sensitif ------------------------------------------
<FilesMatch "^(\.env.*|.*\.sql|package-lock\.json|bun\.lockb)$">
  Require all denied
</FilesMatch>

# Jangan tampilkan daftar isi folder.
Options -Indexes
